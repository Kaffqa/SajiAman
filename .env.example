# SajiAman MBG Environment Configuration

# Data Source Toggle: 'mock' (default offline local state) or 'supabase' (live PostgreSQL + Realtime)
EXPO_PUBLIC_DATA_SOURCE=mock

# Supabase API Credentials (required if EXPO_PUBLIC_DATA_SOURCE=supabase)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 1-Tap Demo Credentials for Field Testing
EXPO_PUBLIC_DEMO_KITCHEN_EMAIL=chef.hendra@sajiaman.id
EXPO_PUBLIC_DEMO_KITCHEN_PASSWORD=SajiAmanDemo2026!
EXPO_PUBLIC_DEMO_SCHOOL_EMAIL=busari.sdn01@sajiaman.id
EXPO_PUBLIC_DEMO_SCHOOL_PASSWORD=SajiAmanDemo2026!

# Dual-AI Multimodal Vision (Gemini Primary -> Groq Vision Fallback)
# Production: set GEMINI_API_KEY & GROQ_API_KEY via `supabase secrets set` (keep EXPO_PUBLIC_* empty in release APK)
EXPO_PUBLIC_GEMINI_MODEL=gemini-4-hydrogen
EXPO_PUBLIC_GROQ_MODEL=qwen/qwen3.8-27b
EXPO_PUBLIC_AI_PROVIDER_ORDER=gemini,groq
# Local QA only:
# EXPO_PUBLIC_GEMINI_API_KEY=
# EXPO_PUBLIC_GROQ_API_KEY=
GEMINI_API_KEY=MY_GEMINI_API_KEY
GROQ_API_KEY=MY_GROQ_API_KEY
APP_URL=MY_APP_URL
